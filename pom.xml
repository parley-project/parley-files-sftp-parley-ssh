<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<!-- License, developer, SCM, URL, Java level and the Maven Central release profile
	     all come from parley-parent. -->
	<parent>
		<groupId>us.bringardner.parley</groupId>
		<artifactId>parley-parent</artifactId>
		<version>1.0.0</version>
		<relativePath>../parley-parent/pom.xml</relativePath>
	</parent>

	<artifactId>parley-files-sftp-parley-ssh</artifactId>
	<version>1.0.0</version>
	<name>Parley Files SFTP: parley-ssh</name>
	<description>The parley-ssh provider for parley-files-sftp: SFTP through Parley's own SSH library, no third party code. Put it on the class path; when several providers are there and none is chosen, this one is used.</description>

	<properties>
		<!-- Written to the jar manifest as Automatic-Module-Name -->
		<parley.moduleName>us.bringardner.parley.files.sftp.parley</parley.moduleName>
		<parley.version>1.0.0</parley.version>
	</properties>

	<!-- GitHub Packages. Maven Central releases use: mvn -Prelease clean deploy -->
	<distributionManagement>
		<repository>
			<id>github</id>
			<name>parley-project</name>
			<url>https://maven.pkg.github.com/parley-project/parley-files-sftp-parley-ssh</url>
		</repository>
	</distributionManagement>

	<build>
		<plugins>
			<!-- Attaches the -sources.jar. The version comes from parley-parent; package (not deploy)
			     so the source jar is attached BEFORE the deploy plugin runs. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<executions>
					<execution>
						<id>attach-sources</id>
						<phase>package</phase>
						<goals>
							<goal>jar-no-fork</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- Runs parley-files-sftp's provider test suite (its tests jar) against this provider,
			     with this project's own tests. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<dependenciesToScan>
						<dependency>us.bringardner.parley:parley-files-sftp</dependency>
					</dependenciesToScan>
					<!-- The suite's temporary folders go in target/, a path with no symbolic links in it. On macOS
					     the default one is under /var, a link to private/var, and the embedded test server's readlink
					     can't follow a relative link, so SftpCanonicalPathTest fails there. java.io.tmpdir is only
					     read when the JVM starts, so it has to be set here and not in systemPropertyVariables. -->
					<argLine>-Djava.io.tmpdir=${project.build.directory}</argLine>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<dependencies>
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files-sftp</artifactId>
			<version>${parley.version}</version>
		</dependency>
		<!-- Parley's own SSH library -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-ssh</artifactId>
			<version>${parley.version}</version>
		</dependency>

		<!-- The provider test suite and what it needs -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files-sftp</artifactId>
			<version>${parley.version}</version>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files</artifactId>
			<version>${parley.version}</version>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>5.13.4</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.sshtools</groupId>
			<artifactId>maverick-synergy-server</artifactId>
			<version>3.1.2</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.sshtools</groupId>
			<artifactId>maverick-virtual-session</artifactId>
			<version>3.1.2</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.sshtools</groupId>
			<artifactId>maverick-virtual-filesystem</artifactId>
			<version>3.1.2</version>
			<scope>test</scope>
		</dependency>
		<!-- On Windows the suite's embedded server is MINA's (it registers no provider) -->
		<dependency>
			<groupId>org.apache.sshd</groupId>
			<artifactId>sshd-sftp</artifactId>
			<version>2.19.0</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
